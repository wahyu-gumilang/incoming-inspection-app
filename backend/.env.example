PORT=5000

DB_HOST=auto
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=csi_db

# Where `npm run db:backup` writes dumps. Must be outside the repo.
DB_BACKUP_DIR=
# Optional: path to mysqldump if it is not on PATH or in C:\xampp.
# MYSQLDUMP=

# Signs the session cookie. At least 32 random characters, different per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Browser origins allowed to call the API with cookies (comma-separated).
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5000
