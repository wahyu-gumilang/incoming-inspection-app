# Copy to .env.test. Used by `npm test` and `npm run db:test:reset`.
# DB_NAME must end with _test: the reset script drops and recreates it.
PORT=5001

DB_HOST=auto
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=csi_db_test

# Any 32+ character value works for tests.
JWT_SECRET=test-secret-change-me-0123456789abcdef
# Cheap hashing keeps the auth tests fast. Never set this in .env.
BCRYPT_ROUNDS=4
